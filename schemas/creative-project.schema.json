{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clay-ops://schemas/creative-project.schema.json",
  "title": "CREATIVE_PROJECT", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "name", "brief", "tags", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200}, "brief": {"type": "string", "maxLength": 10000},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
