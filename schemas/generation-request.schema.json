{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clay-ops://schemas/generation-request.schema.json",
  "title": "GENERATION_REQUEST", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "project_id", "run_id", "prompt", "references", "style", "aspect_ratio", "variant_count", "provider", "model", "status", "attempt_status", "error", "approval_id", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "request_id": {"type": "string", "pattern": "^request-[a-z0-9-]+$"},
    "project_id": {"type": "string", "pattern": "^project-[a-z0-9-]+$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9-]+$"},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 20000}, "references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "style": {"type": ["string", "null"]}, "aspect_ratio": {"type": ["string", "null"]}, "variant_count": {"type": "integer", "minimum": 1, "maximum": 16},
    "provider": {"type": "string", "minLength": 1}, "model": {"type": ["string", "null"]},
    "status": {"enum": ["blocked", "awaiting_approval", "queued", "running", "partial", "completed", "failed", "cancelled"]},
    "attempt_status": {"enum": ["not_attempted", "attempted"]}, "error": {"type": ["object", "null"]}, "approval_id": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
