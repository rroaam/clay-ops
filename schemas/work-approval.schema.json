{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clay-ops://schemas/work-approval",
  "$comment": "Work Ledger approval request. Distinct from schemas/approval.schema.json (operational run approvals) and knowledge-candidate.schema.json (Slack intake candidates). Used for decision, status, owner, and canon-write approvals surfaced to Ryan.",
  "title": "WORK_APPROVAL",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "decision_type",
    "project_id",
    "work_item_id",
    "requester",
    "approver",
    "decision_required",
    "options",
    "recommendation",
    "evidence_links",
    "source_pointer",
    "requested_at",
    "due_at",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "approval_id": {"type": "string", "pattern": "^wapproval-[a-z0-9]{12}$"},
    "decision_type": {
      "type": "string",
      "enum": [
        "confirm_status_change",
        "assign_owner",
        "add_contributor",
        "create_blocker",
        "mark_done",
        "escalate_to_needs_approval",
        "confirm_decision",
        "resolve_contradiction"
      ]
    },
    "project_id": {"type": "string", "pattern": "^proj-"},
    "work_item_id": {"type": "string", "pattern": "^work-"},
    "requester": {
      "type": "string",
      "minLength": 1,
      "description": "Actor (human or agent) that raised the approval. 'system:clay-ops' for automated detections."
    },
    "approver": {
      "type": "string",
      "minLength": 1,
      "description": "Only actor authorized to confirm. Default 'Ryan'."
    },
    "decision_required": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Plain-English question being asked."
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "label", "action"],
        "properties": {
          "option_id": {"type": "string"},
          "label": {"type": "string"},
          "action": {
            "type": "string",
            "description": "What happens if this option is selected (e.g., 'approve', 'reject', 'defer')"
          },
          "consequence": {"type": ["string", "null"]}
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["option_id", "reason", "confidence"],
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "type": "string",
          "description": "The option_id the system recommends"
        },
        "reason": {
          "type": "string",
          "description": "Why this option is recommended"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How confident the system is in this recommendation"
        }
      },
      "description": "System recommendation. Never auto-applied without human approval."
    },
    "evidence_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "source_url", "timestamp"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^wev-"},
          "source_url": {"type": "string", "format": "uri"},
          "timestamp": {"type": "string", "format": "date-time"},
          "summary": {"type": ["string", "null"]}
        }
      }
    },
    "source_pointer": {
      "type": "string",
      "description": "Exact pointer to where this approval was raised (e.g., Slack channel/message, Figma file/comment)"
    },
    "requested_at": {"type": "string", "format": "date-time"},
    "due_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {
      "type": "string",
      "enum": ["open", "approved", "rejected", "changes_requested", "superseded", "expired"]
    },
    "response": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["selected_option_id", "responded_at", "responded_by"],
      "properties": {
        "selected_option_id": {"type": "string"},
        "responded_at": {"type": "string", "format": "date-time"},
        "responded_by": {"type": "string"},
        "notes": {"type": ["string", "null"]}
      },
      "description": "Null until human responds. Once filled, never mutated."
    },
    "resolved_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "When the approval reached a terminal state (approved/rejected/changes_requested/superseded/expired). Null if still open."
    },
    "confirmed_metadata": {
      "type": ["object", "null"],
      "description": "Immutable human confirmation audit fields. Only filled when status is approved/rejected/changes_requested.",
      "additionalProperties": false,
      "required": ["method", "device_hint"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["slack_block_action", "cli_resolve", "canvas_button", "webhook"]
        },
        "device_hint": {"type": ["string", "null"]},
        "ip_hint": {"type": ["string", "null"]}
      }
    }
  }
}
