{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clay-ops://schemas/slack-intake-packet",
  "title": "SLACK_INTAKE_PACKET",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intake_id",
    "source",
    "thread",
    "messages",
    "attachments",
    "extracted_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "intake_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "workspace_id", "channel_id", "channel_name"],
      "properties": {
        "platform": {"const": "slack"},
        "workspace_id": {"type": "string", "minLength": 1},
        "channel_id": {"type": "string", "minLength": 1},
        "channel_name": {"type": "string", "minLength": 1}
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_ts", "root_author_id", "root_author_name", "root_message_ts", "root_permalink"],
      "properties": {
        "thread_ts": {"type": "string", "minLength": 1},
        "root_author_id": {"type": "string", "minLength": 1},
        "root_author_name": {"type": "string", "minLength": 1},
        "root_message_ts": {"type": "string", "minLength": 1},
        "root_permalink": {"type": "string", "format": "uri"}
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_ts", "author_id", "author_name", "permalink", "text_preview", "attachment_ids"],
        "properties": {
          "message_ts": {"type": "string", "minLength": 1},
          "author_id": {"type": "string", "minLength": 1},
          "author_name": {"type": "string", "minLength": 1},
          "permalink": {"type": "string", "format": "uri"},
          "text_preview": {"type": "string"},
          "attachment_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attachment_id", "name", "type", "source_link"],
        "properties": {
          "attachment_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "source_link": {"type": "string", "format": "uri"},
          "byte_size": {"type": "integer", "minimum": 0},
          "text_content": {"type": "string"},
          "text_content_trust_level": {
            "type": "string",
            "enum": ["untrusted", "adapter_extracted", "none"]
          }
        }
      }
    },
    "extracted_at": {"type": "string", "format": "date-time"},
    "pilot_label": {"type": "string"}
  }
}
