{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clay-ops://schemas/event.schema.json",
  "title": "EVENT",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "run_id", "sequence", "event_type", "status", "actor", "recorded_at", "payload", "previous_hash", "record_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"},
    "previous_hash": {"anyOf": [{"const": "GENESIS"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
