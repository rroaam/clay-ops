{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clay-ops://schemas/creative-asset.schema.json",
  "title": "CREATIVE_ASSET", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "asset_id", "project_id", "request_id", "run_id", "parent_asset_id", "variant_index", "name", "mime_type", "relative_path", "sha256", "byte_size", "width", "height", "favorite", "tags", "provenance", "evidence", "status", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "asset_id": {"type": "string", "pattern": "^asset-[a-z0-9-]+$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9-]+$"},
    "request_id": {"type": ["string", "null"]}, "run_id": {"type": ["string", "null"]}, "parent_asset_id": {"type": ["string", "null"]}, "variant_index": {"type": ["integer", "null"], "minimum": 0},
    "name": {"type": "string", "minLength": 1}, "mime_type": {"enum": ["image/png", "image/jpeg", "image/webp", "image/gif"]}, "relative_path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "byte_size": {"type": "integer", "minimum": 1}, "width": {"type": ["integer", "null"], "minimum": 1}, "height": {"type": ["integer", "null"], "minimum": 1},
    "favorite": {"type": "boolean"}, "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "provenance": {"type": "object", "minProperties": 1}, "evidence": {"type": "object", "minProperties": 1},
    "status": {"enum": ["available", "partial", "failed", "cancelled"]}, "created_at": {"type": "string", "format": "date-time"}
  }
}
